# Application
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Set to the built SPA directory to serve the web from the API. Empty in development.
WEB_DIST_PATH=

# Data stores
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Mail — mailpit catches everything in development, read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Standard <no-reply@standard.test>"

# Auth — BETTER_AUTH_SECRET must be at least 16 characters
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min

# Rate limiting, applied to the auth routes
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
