# Application
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Set to the built SPA directory to serve the web from the API. Empty in development.
WEB_DIST_PATH=
# The API reference UI at /api and its OpenAPI document at /api/spec.json are served
# outside production and hidden in production. Set true or false to override either way.
API_REFERENCE_ENABLED=

# Data stores
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Object storage. Required: the api refuses to start without a bucket to write to.
# docker compose brings up a local S3 compatible store and creates the bucket; the console
# is at http://localhost:9101/rustfs/console/.
# The host ports are 9100 and 9101 because 9000 is crowded on developer machines.
STORAGE_ENDPOINT=http://localhost:9100
# The origin the browser uses to fetch presigned links. Leave empty when it is the same
# as STORAGE_ENDPOINT; set it when the api reaches the store on an in-cluster address.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=standard
STORAGE_ACCESS_KEY_ID=app
STORAGE_SECRET_ACCESS_KEY=appsecret
STORAGE_REGION=auto
# Lifetime of the signed read URLs handed to the browser. The upload ceiling is not an env
# value: it is NOTE_ATTACHMENT_MAX_BYTES in @app/schemas, shared with the web.
STORAGE_URL_EXPIRY_SECONDS=900

# Mail: mailpit catches everything in development, read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Standard <no-reply@standard.test>"

# Auth: BETTER_AUTH_SECRET must be at least 32 characters
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min

# Several apps behind this one login, all empty for a single app; docs/operations/README.md has
# the full rules. AUTH_COOKIE_DOMAIN is the parent domain every app shares (for example
# .example.com) and must contain BETTER_AUTH_URL's host. AUTH_TRUSTED_ORIGINS lists the other
# apps' origins, comma-separated, and accepts a wildcard only as the whole leftmost label, such
# as https://*.example.com; they join WEB_ORIGIN for CORS and CSRF, and also decide where a
# password reset link may send its token. With AUTH_JWT_ENABLED=true a signed-in user can fetch
# a 15 minute JWT from /api/auth/token, and the other APIs verify it through /api/auth/jwks.
AUTH_COOKIE_DOMAIN=
AUTH_TRUSTED_ORIGINS=
AUTH_JWT_ENABLED=

# Self sign-up at /register. Off unless set to true, so only an admin adds people; turn on
# VITE_AUTH_SIGN_UP_ENABLED in apps/web/.env with it, or the web keeps hiding the page.
AUTH_SIGN_UP_ENABLED=

# Seed. Outside production the seeded logins use Password123 unless this is set.
# In production the seed refuses to run without it, and then creates only the admin.
SEED_PASSWORD=

# Logging. Leave the transport empty to write JSON to stdout for a collector to read.
# Set a target only to ship from the process itself, for example pino-loki with
# LOG_TRANSPORT_OPTIONS={"host":"http://loki:3100"}
LOG_LEVEL=
LOG_TRANSPORT_TARGET=
LOG_TRANSPORT_OPTIONS=

# Activity log retention. Rows older than this are pruned by the worker every day.
ACTIVITY_RETENTION_DAYS=90

# Rate limiting, applied to the auth routes
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
# Comma-separated proxy source IPs allowed to supply X-Forwarded-For. The proxy must overwrite this header.
RATE_LIMIT_TRUSTED_PROXY_IPS=

# Metrics. /metrics serves the Prometheus text format on the same origin as the app,
# so production refuses to start with metrics on and no token. Send it as
# Authorization: Bearer <token>. At least 32 characters, like any other secret.
METRICS_ENABLED=true
METRICS_TOKEN=

# Tracing. Leave the endpoint empty and no spans are created and nothing is exported.
# Set it to an OTLP over HTTP traces collector, for example http://collector:4318/v1/traces.
# TRACING_HEADERS is JSON, for a collector that needs an API key.
TRACING_ENDPOINT=
TRACING_HEADERS=
TRACING_SAMPLE_RATIO=1
