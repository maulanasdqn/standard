# Application
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Set to the built SPA directory to serve the web from the API. Empty in development.
WEB_DIST_PATH=

# Data stores
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# Mail: mailpit catches everything in development, read it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Standard <no-reply@standard.test>"

# Auth: BETTER_AUTH_SECRET must be at least 32 characters
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min

# Logging. Leave the transport empty to write JSON to stdout for a collector to read.
# Set a target only to ship from the process itself, for example pino-loki with
# LOG_TRANSPORT_OPTIONS={"host":"http://loki:3100"}
LOG_LEVEL=
LOG_TRANSPORT_TARGET=
LOG_TRANSPORT_OPTIONS=

# Activity log retention. Rows older than this are pruned by the worker every day.
ACTIVITY_RETENTION_DAYS=90

# Rate limiting, applied to the auth routes
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
# Comma-separated proxy source IPs allowed to supply X-Forwarded-For. The proxy must overwrite this header.
RATE_LIMIT_TRUSTED_PROXY_IPS=
