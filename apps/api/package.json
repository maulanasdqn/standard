{
	"name": "@app/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/main.ts",
		"start": "tsx --env-file=.env src/main.ts",
		"worker": "tsx --env-file=.env src/worker.ts",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file=.env src/infrastructure/db/seed.ts"
	},
	"dependencies": {
		"@app/core": "workspace:*",
		"@app/errors": "workspace:*",
		"@app/logger": "workspace:*",
		"@app/migrations": "workspace:*",
		"@app/permissions": "workspace:*",
		"@app/schemas": "workspace:*",
		"@hono/node-server": "^1.19.11",
		"@mobily/ts-belt": "^3.13.1",
		"@orpc/json-schema": "^1.13.6",
		"@orpc/openapi": "^1.13.6",
		"@orpc/server": "^1.13.6",
		"@orpc/zod": "^1.13.6",
		"better-auth": "^1.5.3",
		"bullmq": "^5.56.0",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.9",
		"ioredis": "^5.10.1",
		"pg": "^8.16.3",
		"ts-pattern": "^5.9.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.3.6",
		"@types/pg": "^8.15.6",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.0.5"
	}
}
