{
	"name": "@app/api",
	"version": "0.8.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/bootstrap/index.ts"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/main.ts",
		"start": "tsx --env-file-if-exists=.env src/main.ts",
		"worker": "tsx --env-file-if-exists=.env src/worker/run.ts",
		"migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
		"arch": "tsx scripts/check-architecture.ts",
		"migrations": "tsx scripts/check-migrations.ts",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts"
	},
	"dependencies": {
		"@app/activity": "workspace:*",
		"@app/cache": "workspace:*",
		"@app/logger": "workspace:*",
		"@app/mail": "workspace:*",
		"@app/messages": "workspace:*",
		"@app/metrics": "workspace:*",
		"@app/migrations": "workspace:*",
		"@app/permissions": "workspace:*",
		"@app/queue": "workspace:*",
		"@app/schemas": "workspace:*",
		"@app/tracing": "workspace:*",
		"@app/version": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"@mobily/ts-belt": "^3.13.1",
		"@orpc/json-schema": "^1.13.6",
		"@orpc/openapi": "^1.13.6",
		"@orpc/server": "^1.13.6",
		"@orpc/zod": "^1.13.6",
		"amqplib": "^2.0.1",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.45.1",
		"effect": "4.0.0-rc.115",
		"hono": "^4.12.9",
		"ioredis": "^6.0.0",
		"pg": "^8.16.3",
		"ts-pattern": "^5.9.0",
		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@types/pg": "^8.15.6",
		"dotenv": "^17.3.1",
		"drizzle-kit": "^0.31.9",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.0"
	}
}
