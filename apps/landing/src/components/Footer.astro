---
import { APP_MESSAGE, BLOG_MESSAGE, LANDING_MESSAGE } from "@app/messages";
import { APP_VERSION } from "@app/version";
import { BLOG_PATH, RSS_PATH } from "../lib/blog/paths.ts";
import { APP_LINK } from "../lib/links.ts";
---

<footer class="border-t">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
	>
		<p>
			<span class="font-semibold text-foreground">{APP_MESSAGE.NAME}</span>
			<span class="mx-2" aria-hidden="true">·</span>
			{`${LANDING_MESSAGE.FOOTER_VERSION} ${APP_VERSION}`}
		</p>
		<ul class="flex gap-6">
			<li>
				<a href={BLOG_PATH} class="transition-colors hover:text-foreground">
					{BLOG_MESSAGE.NAV_BLOG}
				</a>
			</li>
			<li>
				<a href={RSS_PATH} class="transition-colors hover:text-foreground">
					{BLOG_MESSAGE.RSS}
				</a>
			</li>
			<li>
				<a href={APP_LINK.SIGN_IN} class="transition-colors hover:text-foreground">
					{LANDING_MESSAGE.SIGN_IN}
				</a>
			</li>
		</ul>
	</div>
</footer>
