---
export type TSectionHeaderProps = {
	eyebrow: string;
	title: string;
	lede?: string;
};

type Props = TSectionHeaderProps;

const props = Astro.props;
---

<header class="max-w-2xl">
	<p class="text-sm font-medium text-muted-foreground">{props.eyebrow}</p>
	<h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
		{props.title}
	</h2>
	{
		props.lede && (
			<p class="mt-4 text-base leading-relaxed text-muted-foreground">
				{props.lede}
			</p>
		)
	}
</header>
