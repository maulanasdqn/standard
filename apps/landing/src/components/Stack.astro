---
import { A } from "@mobily/ts-belt";
import { LANDING_MESSAGE, LANDING_STACK } from "@app/messages";
import { SECTION_ID } from "../lib/links.ts";
import SectionHeader from "./SectionHeader.astro";
---

<section id={SECTION_ID.STACK} class="scroll-mt-20 border-t">
	<div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
		<SectionHeader
			eyebrow={LANDING_MESSAGE.STACK_EYEBROW}
			title={LANDING_MESSAGE.STACK_TITLE}
			lede={LANDING_MESSAGE.STACK_LEDE}
		/>
		<dl class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				A.map(LANDING_STACK, (group) => (
					<div>
						<dt class="text-sm font-semibold">{group.title}</dt>
						<dd class="mt-3">
							<ul class="flex flex-wrap gap-2">
								{A.map(group.items, (item) => (
									<li class="rounded-md border px-2.5 py-1 text-sm text-muted-foreground">
										{item}
									</li>
								))}
							</ul>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
