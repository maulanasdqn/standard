---
import { A } from "@mobily/ts-belt";
import { BLOG_MESSAGE } from "@app/messages";
import { postPathOf } from "../../lib/blog/paths.ts";
import type { TPost } from "../../lib/blog/posts.ts";
import PostDates from "./PostDates.astro";
import TagList from "./TagList.astro";

export type TPostListProps = {
	posts: readonly TPost[];
};

type Props = TPostListProps;

const props = Astro.props;
---

{
	A.isEmpty(props.posts) ? (
		<p class="text-muted-foreground">{BLOG_MESSAGE.EMPTY}</p>
	) : (
		<ul class="divide-y border-y">
			{A.map(props.posts, (post) => (
				<li class="py-8">
					<article>
						<PostDates publishedAt={post.data.publishedAt} />
						<h2 class="mt-2 text-xl font-semibold tracking-tight">
							<a href={postPathOf(post.id)} class="hover:underline">
								{post.data.title}
							</a>
						</h2>
						<p class="mt-2 text-muted-foreground">{post.data.description}</p>
						<div class="mt-4">
							<TagList tags={post.data.tags} />
						</div>
					</article>
				</li>
			))}
		</ul>
	)
}
